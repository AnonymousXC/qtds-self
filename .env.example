# Environment Configuration for QTDS

# App
ENVIRONMENT=development
DEBUG=true

# Database (Default: local SQLite async database)
DATABASE_URL=sqlite+aiosqlite:///./qtds.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/qtds

# AI Quantum Security Copilot (OpenAI Compatible)
# Leave blank to use the built-in offline deterministic quantum reasoning engine
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Deterministic Security Engine Thresholds
FORGERY_THRESHOLD=0.15
REPLAY_SIMILARITY_THRESHOLD=0.92
CHANNEL_TAMPER_THRESHOLD=0.10
CHI_SQUARE_ALPHA=0.05
MIN_ACCEPTABLE_FIDELITY=0.85
